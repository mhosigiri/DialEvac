# Copy to .env and fill in. .env is gitignored; never commit real values.
# The services read this file through `tsx --env-file=../.env`.

# SpacetimeDB: where the services connect. The module itself never reads this file.
SPACETIME_URI=ws://127.0.0.1:3000
SPACETIME_DATABASE=hackutd
# Optional. An identity token; leave empty to connect anonymously.
SPACETIME_TOKEN=

# Module environment. SpacetimeDB installs these at publish time, not from this file.
# They are listed here so one file holds every setting.
# Leave SOLVER_URL out at publish and the module plans with its built-in heuristic.
SOLVER_URL=http://127.0.0.1:8799
SOLVER_TOKEN=
# NWS alert area (state or marine zone code) the feed polls, e.g. TX. Empty turns the feed off.
FEED_AREA=TX

# Photon (Spectrum): iMessage text fallback and callbacks.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# imessage, or terminal to print messages locally instead of sending them.
PHOTON_PROVIDER=terminal

# Twilio: outbound survey calls and status callbacks.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Signs Twilio's webhooks; the voice service checks every one.
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VALIDATE_SIGNATURE=true
# Public HTTPS address Twilio reaches the voice service at (a tunnel to VOICE_PORT works).
VOICE_PUBLIC_URL=
VOICE_PORT=8080
# Calls placed per second, most urgent first. Twilio's default is 1; raise it there first.
VOICE_CALLS_PER_SECOND=1

# Real numbers the services may call or text, comma-separated, E.164. "*" allows any.
# 555 numbers are fictional and are never contacted, whatever this says.
CONTACT_ALLOWLIST=

# The conversational voice agent, ported from Standard-Response next. Unused until then.
ANTHROPIC_API_KEY=
VOICE_MODEL=claude-haiku-5-5
CARTESIA_API_KEY=
CARTESIA_VOICE_EN=
CARTESIA_VOICE_ES=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
BITDEER_API_KEY=
ELEVENLABS_API_KEY=
