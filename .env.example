# Copy to .env and fill in. .env is gitignored; never commit real values.
# Local npm scripts load this file when it exists. Deployed containers read real environment variables.
# DEPLOYMENT.md lists what each deployed process needs.

# Spacetime: the shared Maincloud database. The module itself never reads this file.
# Services and the live portal use hackutd-535md; isolated map demos use hackutd-richardson.
SPACETIME_URI=wss://maincloud.spacetimedb.com
SPACETIME_DATABASE=hackutd-535md
# Optional. An identity token; leave empty to connect anonymously.
SPACETIME_TOKEN=

# Module environment. SpacetimeDB installs these at publish time, not from this file.
# They are listed here so one file holds every setting.
# Leave SOLVER_URL out at publish and the module plans with its built-in heuristic.
SOLVER_URL=http://127.0.0.1:8799
SOLVER_TOKEN=
# Comma-separated identity hex strings allowed to write. See services/AUTHORIZATION.md.
OPERATOR_IDENTITIES=
SERVICE_IDENTITIES=
# Isolated demo database only. `true` makes every browser an operator over simulated records.
DEMO_MODE=
DEMO_PUBLIC_DISPATCH=
# OSMnx route service (run `cd dispatch && uv run python routing_server.py`).
# Node services read OSMNX_ROUTER_URL; a published module's ROUTER_URL must be public.
OSMNX_ROUTER_URL=http://127.0.0.1:8800
# Optional Python settings; load .env with `uv run --env-file ../.env ...`.
OSMNX_HOST=127.0.0.1
OSMNX_PORT=8800
# Optional alternate/self-hosted Overpass base URL, ending in /api (no /interpreter).
OSMNX_OVERPASS_URL=
# Directory for downloaded road graphs. Deployed routers mount a persistent volume here.
OSMNX_CACHE_DIR=
# Optional prebuilt OSMnx GraphML driving network to serve routes without downloads.
OSMNX_GRAPHML=
GEMINI_API_KEY=
GEMINI_ROUTE_MODEL=gemini-3.1-flash-lite
# Route bridge stays on the isolated demo database, using an existing service grant.
SPACETIME_DEMO_SERVICE_TOKEN=
# Local rehearsal scripts only; `npm run check:safety` needs both.
SPACETIME_DEMO_OPERATOR_TOKEN=
SPACETIME_DEMO_VIEWER_TOKEN=
# NWS alert area (state or marine zone code) the feed polls, e.g. TX. Empty turns the feed off.
FEED_AREA=TX
# IEM radar tiles need no key. Storm reports are not enabled.

# Photon (Beta API): iMessage texts and replies over a shared line. A resident has to text their
# assigned line once before it can text them (Photon's shared-line rule).
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# imessage, or terminal to print messages locally instead of sending them.
PHOTON_PROVIDER=terminal
# Photon SIP outbound: calls go out through Photon so they show the Photon number.
# From the Photon voice profile's Outbound calls section. The password is shown once on Enable outbound.
# Set the profile's digest algorithm to SHA-256 (ElevenLabs requires it).
PHOTON_SIP_SERVER=sip.photon.codes:5061
PHOTON_SIP_USERNAME=
PHOTON_SIP_PASSWORD=

# Voice calls: an ElevenLabs agent talks with the resident over the Photon line.
# The Photon number calls come from and residents call in on, E.164.
VOICE_FROM_NUMBER=

# ElevenLabs. Set the API key, then `npm run setup:elevenlabs` (in services/) creates the webhook,
# the agent and the imported Photon number, and writes the four values below.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_WEBHOOK_URL=

# Public HTTPS address ElevenLabs sends call results to (a tunnel to VOICE_PORT works).
VOICE_PUBLIC_URL=
# A PORT set by a container host overrides VOICE_PORT.
VOICE_PORT=8080
# Calls started per second, most urgent first.
VOICE_CALLS_PER_SECOND=1

# Real numbers the services may call or text, comma-separated, E.164. "*" allows any.
# 555 numbers are fictional and are never contacted, whatever this says.
CONTACT_ALLOWLIST=

# Claude post-call transcript analysis (server only).
ANTHROPIC_API_KEY=
CALL_ANALYSIS_MODEL=claude-haiku-4-5
# Synthetic voice evaluations (no telephone calls); optional dedicated test agent.
VOICE_EVAL_AGENT_ID=
VOICE_EVAL_JUDGE_MODEL=claude-opus-5-5

# Blocking speech guard. `npm run voice:guard:prepare` and `voice:guard:configure` use the first two.
VOICE_GUARD_TOKEN=
ELEVENLABS_GUARD_SECRET_ID=
VOICE_GUARD_MODEL=gemini-3.1-flash-lite
VOICE_GUARD_UPSTREAM_URL=
VOICE_GUARD_UPSTREAM_KEY=

# Browser builds read these at build time, so they become public. Never put a token in a VITE_ variable.
VITE_SPACETIME_URI=wss://maincloud.spacetimedb.com
VITE_SPACETIME_DATABASE=hackutd-richardson
VITE_MAP_URL=/map/index.html

# Twilio outbound transport for the local portal's Launch outreach button.
# CONTACT_ALLOWLIST must contain exactly three distinct real E.164 numbers, never '*'.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
# Generated privately by `npm run twilio:setup -- --prepare` and `npm run twilio:setup`.
TWILIO_OUTREACH_TOKEN=
ELEVENLABS_TWILIO_AGENT_ID=
ELEVENLABS_TWILIO_PHONE_NUMBER_ID=
ELEVENLABS_TWILIO_GUARD_SECRET_ID=
ELEVENLABS_TWILIO_WEBHOOK_ID=
ELEVENLABS_TWILIO_WEBHOOK_SECRET=
ELEVENLABS_TWILIO_WEBHOOK_URL=
