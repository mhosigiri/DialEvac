# Copy to .env and fill in. .env is gitignored; never commit real values.
# The services read this file through `tsx --env-file=../.env`.

# SpacetimeDB: where the services connect. The module itself never reads this file.
SPACETIME_URI=ws://127.0.0.1:3000
SPACETIME_DATABASE=hackutd
# Optional. An identity token; leave empty to connect anonymously.
SPACETIME_TOKEN=

# Module environment. SpacetimeDB installs these at publish time, not from this file.
# They are listed here so one file holds every setting.
# Leave SOLVER_URL out at publish and the module plans with its built-in heuristic.
SOLVER_URL=http://127.0.0.1:8799
SOLVER_TOKEN=
# NWS alert area (state or marine zone code) the feed polls, e.g. TX. Empty turns the feed off.
FEED_AREA=TX

# Photon (Spectrum): iMessage text fallback and callbacks.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# imessage, or terminal to print messages locally instead of sending them.
PHOTON_PROVIDER=terminal
# Photon SIP outbound: calls go out through Photon so they show the Photon number.
# From the Photon voice profile's Outbound calls section. The password is shown once on Enable outbound.
# Digest algorithm: SHA-256 for ElevenLabs; MD5 (legacy) only if VOICE_PROVIDER=twilio.
PHOTON_SIP_SERVER=sip.photon.codes:5061
PHOTON_SIP_USERNAME=
PHOTON_SIP_PASSWORD=

# Voice calls. elevenlabs (default): an ElevenLabs agent talks with the resident.
# twilio: Twilio speaks the survey and reads the keypad (a trial account can't dial through Photon).
VOICE_PROVIDER=elevenlabs
# The Photon number calls come from, E.164.
VOICE_FROM_NUMBER=

# ElevenLabs. Set the API key, then `npm run setup:elevenlabs` (in services/) creates the webhook,
# the agent and the imported Photon number, and writes the four values below.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_WEBHOOK_URL=

# Twilio: only for VOICE_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Signs Twilio's webhooks; the voice service checks every one.
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=true
# Public HTTPS address ElevenLabs and Twilio send call results to (a tunnel to VOICE_PORT works).
VOICE_PUBLIC_URL=
VOICE_PORT=8080
# Calls started per second, most urgent first.
VOICE_CALLS_PER_SECOND=1

# Real numbers the services may call or text, comma-separated, E.164. "*" allows any.
# 555 numbers are fictional and are never contacted, whatever this says.
CONTACT_ALLOWLIST=

# The conversational voice agent, ported from Standard-Response next. Unused until then.
ANTHROPIC_API_KEY=
VOICE_MODEL=claude-haiku-5-5
CARTESIA_API_KEY=
CARTESIA_VOICE_EN=
CARTESIA_VOICE_ES=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
BITDEER_API_KEY=
