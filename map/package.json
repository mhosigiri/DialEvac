{
  "name": "hackutd-floodplain-map",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../spacetimedb --no-config",
    "build": "esbuild src/spacetime.ts --bundle --format=iife --global-name=DIALEVAC --outfile=assets/spacetime.js",
    "serve": "npm run build && python3 tools/serve.py",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "spacetimedb": "2.14.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
