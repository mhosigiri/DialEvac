{
  "name": "floodplain-map-live",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../../spacetimedb --no-config",
    "build": "esbuild src/live-data.ts --bundle --format=iife --target=es2020 --minify --outfile=../assets/live-data.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "spacetimedb": "2.14.1"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "typescript": "^5.9.0"
  }
}
