{
  "name": "hackutd-services",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../spacetimedb --no-config",
    "messaging": "tsx --env-file=../.env src/messaging.ts",
    "voice": "tsx --env-file=../.env src/voice.ts",
    "typecheck": "tsc --noEmit",
    "check:connections": "tsx --env-file=../.env scripts/check-connections.ts",
    "check:safety": "tsx --env-file=../.env scripts/check-safety.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "setup:elevenlabs": "tsx --env-file=../.env scripts/elevenlabs-setup.ts"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.77.0",
    "spacetimedb": "2.14.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
